{
  "name": "flexdoc-monorepo",
  "version": "1.0.0",
  "description": "Prauga FlexDoc: self-hosted OpenAPI documentation and API exploration",
  "private": true,
  "engines": {
    "node": ">=22.22.3"
  },
  "workspaces": [
    "packages/*",
    "packages/examples/*"
  ],
  "files": [
    "dist",
    "lib",
    "examples"
  ],
  "scripts": {
    "build": "npm run build:client && npm run build:backend",
    "dev:client": "npm run dev -w packages/client",
    "dev:backend": "npm run dev -w packages/backend",
    "build:core": "npm install --prefix core --ignore-scripts --no-audit --no-fund && npm run build --prefix core",
    "build:client": "npm run build:core && npm run build -w packages/client",
    "build:backend": "npm run build -w packages/backend",
    "sync:adapter-assets": "node scripts/sync-adapter-assets.mjs",
    "check:adapter-assets": "node scripts/sync-adapter-assets.mjs --check",
    "check:example-versions": "node scripts/check-example-versions.mjs",
    "lint": "npm run lint -w packages/client && npm run lint -w packages/examples/nestjs",
    "audit": "npm audit --audit-level=low",
    "example:nestjs": "cd packages/examples/nestjs && npm install && npm run start:dev",
    "test": "npm run build:core && npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present"
  },
  "keywords": [
    "flexdoc",
    "openapi",
    "api-documentation",
    "api-docs",
    "api-explorer",
    "self-hosted",
    "swagger",
    "developer-tools"
  ],
  "author": "Prauga",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/Prauga/flexdoc"
  },
  "bugs": {
    "url": "https://github.com/prauga/flexdoc/issues"
  },
  "homepage": "https://github.com/prauga/flexdoc#readme",
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0 || ^12.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    }
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.525.0",
    "prismjs": "^1.29.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "overrides": {
    "test-exclude": "$test-exclude"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "test-exclude": "8.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.3.6"
  }
}
