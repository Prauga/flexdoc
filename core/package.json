{
  "name": "@bluejeans/flexdoc-core",
  "version": "0.1.0",
  "description": "Framework-neutral OpenAPI engine for FlexDoc",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": { "js-yaml": "^4.1.0" },
  "devDependencies": { "@types/js-yaml": "^4.0.9", "typescript": "^5.0.0" },
  "keywords": ["openapi", "api", "serialization", "api-client", "documentation"],
  "author": "Vishnu R <vishnurajesh45@gmail.com>",
  "license": "AGPL-3.0-or-later",
  "repository": { "type": "git", "url": "https://github.com/bluejeans117/flexdoc.git", "directory": "core" }
}
