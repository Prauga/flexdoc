{
  "name": "@prauga/flexdoc-backend",
  "version": "2.2.0",
  "description": "Thin self-hosted FlexDoc integrations for Express, Fastify, and NestJS",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": { "flexdoc-auth-generator": "dist/scripts/generate-auth.js" },
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc && node scripts/copy-renderer.js",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "generate:basic": "npx ts-node src/scripts/generate-auth.ts basic",
    "generate:bearer": "npx ts-node src/scripts/generate-auth.ts bearer"
  },
  "keywords": ["flexdoc", "openapi", "api-documentation", "api-docs", "api-explorer", "express", "fastify", "nestjs", "self-hosted", "swagger", "developer-tools"],
  "author": "Prauga",
  "license": "AGPL-3.0-or-later",
  "repository": { "type": "git", "url": "https://github.com/prauga/flexdoc.git", "directory": "packages/backend" },
  "bugs": { "url": "https://github.com/prauga/flexdoc/issues" },
  "homepage": "https://github.com/prauga/flexdoc#readme",
  "peerDependencies": { "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0", "@nestjs/core": "^10.0.0 || ^11.0.0 || ^12.0.0" },
  "peerDependenciesMeta": { "@nestjs/common": { "optional": true }, "@nestjs/core": { "optional": true } },
  "dependencies": { "jsonwebtoken": "^9.0.2", "yargs": "^17.7.2" },
  "devDependencies": {
    "@nestjs/common": "^12.0.1", "@nestjs/core": "^12.0.1", "@nestjs/testing": "^12.0.1",
    "@types/jest": "^30.0.0", "@types/jsonwebtoken": "^9.0.5", "@types/node": "^22.0.0", "@types/yargs": "^17.0.32",
    "jest": "^30.5.0", "ts-jest": "^29.4.12", "ts-node": "^10.9.2", "typescript": "^5.9.2"
  }
}
